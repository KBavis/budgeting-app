# ==============================================================================
# Jenkins Local CI/CD Controller - Secrets & Configuration Template
# ==============================================================================
# Copy this file to .env.jenkins in the jenkins/ directory:
#   cp jenkins/.env.jenkins.example jenkins/.env.jenkins
#
# Then fill in your secrets and start Jenkins with:
#   docker compose -f jenkins/docker-compose.jenkins.yml up -d --build

# ------------------------------------------------------------------------------
# Jenkins UI Admin Credentials
# ------------------------------------------------------------------------------
JENKINS_ADMIN_USER=admin
JENKINS_ADMIN_PASSWORD=adminpassword

# ------------------------------------------------------------------------------
# CI/CD Pipeline Credentials
# ------------------------------------------------------------------------------
# 1. Docker Hub Account
DOCKER_USER=your_dockerhub_username
DOCKERHUB_PASSWORD=your_dockerhub_personal_access_token

# 2. Production Server Configuration
SERVER_IP=your_production_server_ip
SSH_USER=deployuser
DEPLOY_PATH=/home/deployuser
SSH_PRIVATE_KEY="-----BEGIN OPENSSH PRIVATE KEY-----\nPASTE_YOUR_FULL_SSH_PRIVATE_KEY_HERE\n-----END OPENSSH PRIVATE KEY-----"

# 3. Optional: Repository URL override (defaults to https://github.com/KBavis/budgeting-app.git)
REPO_URL=https://github.com/KBavis/budgeting-app.git
