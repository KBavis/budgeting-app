# ==============================================================================
# Budgeting Application - Environment Configuration Template
# ==============================================================================
# Copy this file to .env and adjust the values for your environment.
# Local defaults are provided below for immediate out-of-the-box development.

# ------------------------------------------------------------------------------
# Database Configuration (PostgreSQL)
# ------------------------------------------------------------------------------
DB_HOST=localhost
DB_PORT=5432
DB_NAME=budget-app
DB_USER=postgres
DB_PASS=postgres

# Spring Data Source URL (Optional override, defaults to constructed DB_* or jdbc:postgresql://localhost:5432/budget-app)
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/budget-app
SPRING_DATASOURCE_USERNAME=postgres
SPRING_DATASOURCE_PASSWORD=postgres

# ------------------------------------------------------------------------------
# Plaid API Configuration
# ------------------------------------------------------------------------------
# Get your Plaid credentials at https://dashboard.plaid.com
PLAID_CLIENT_ID=your_plaid_client_id
PLAID_SECRET=your_plaid_secret
PLAID_BASE_URL=https://sandbox.plaid.com
# For production: https://production.plaid.com

# ------------------------------------------------------------------------------
# Mailgun Configuration (Inbound Webhook & Email Processing)
# ------------------------------------------------------------------------------
MAILGUN_API_KEY=your_mailgun_api_key
MAILGUN_INGEST_DOMAIN=mail.bavisbudgeting.com
MAILGUN_BASE_URL=https://api.mailgun.net
MAILGUN_SANDBOX_DOMAIN=sandbox58c345fc55c14b7eb3d84436680dad35.mailgun.org

# ------------------------------------------------------------------------------
# Inter-Service & Networking Configuration
# ------------------------------------------------------------------------------
# Suggestion engine endpoint (Python FastAPI service)
SUGGESTION_ENGINE_URL=http://localhost:8000/

# Allowed CORS origins for the Spring Boot backend
CORS_ALLOWED_ORIGINS=http://localhost:3000

# Frontend API URL override (Optional in prod, defaults to relative "" or http://localhost:8080 in dev)
REACT_APP_API_URL=http://localhost:8080

# Logging Levels
LOG_LEVEL_SECURITY=DEBUG
LOG_LEVEL_APP=DEBUG

# ------------------------------------------------------------------------------
# Production Image Registry & Versions (Used by compose.yaml)
# ------------------------------------------------------------------------------
DOCKER_USER=your_dockerhub_username
BACKEND_VERSION=1.0.0
FRONTEND_VERSION=1.0.0
